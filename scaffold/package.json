{
  "name": "create-empilha",
  "version": "0.2.2",
  "private": false,
  "description": "Gerador de projetos para o Empilha.",
  "bin": {
    "create-empilha": "bin/create-empilha.ts"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun node_modules/empilha/scripts/application/dev.ts src/app.ts",
    "start": "bun src/app.ts",
    "test": "bun test",
    "generate:queries": "bun node_modules/empilha/scripts/application/generate-query-types.ts src/queries src/queries/query-artifacts.ts --artifacts",
    "doctor": "bun node_modules/empilha/scripts/application/doctor.ts --module src/modules/app.module.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "empilha": "^0.2.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
