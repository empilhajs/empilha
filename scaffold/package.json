{
  "name": "create-empilha",
  "version": "0.1.4",
  "private": false,
  "description": "Gerador de projetos para o Empilha.",
  "bin": {
    "create-empilha": "bin/create-empilha.ts"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun node_modules/empilha/scripts/dev.ts src/app.ts",
    "start": "bun src/app.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test",
    "migrate": "bun node_modules/empilha/scripts/migrate.ts",
    "generate:queries": "bun node_modules/empilha/scripts/generate-query-types.ts ./src/queries ./src/queries/query-names.ts queryNames"
  },
  "dependencies": {
    "empilha": "^0.1.8",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/pg": "^8.11.10",
    "typescript": "^7.0.2"
  }
}
