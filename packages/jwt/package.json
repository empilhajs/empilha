{
  "name": "@empilha/jwt",
  "version": "0.2.4",
  "description": "Integração JWT para o framework Empilha usando jose.",
  "keywords": [
    "authentication",
    "bun",
    "empilha",
    "jwt",
    "typescript"
  ],
  "homepage": "https://github.com/empilhajs/empilha/tree/main/packages/jwt",
  "bugs": {
    "url": "https://github.com/empilhajs/empilha/issues"
  },
  "license": "MIT",
  "author": "Everton Da Silva Vieira",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/empilhajs/empilha.git",
    "directory": "packages/jwt"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --target bun --format esm --external empilha --external jose && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test tests",
    "check": "bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "empilha": "^0.2.4",
    "jose": "^6.2.4",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@sinclair/typebox": "^0.34.0",
    "empilha": ">=0.2.4",
    "jose": "^6.0.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
